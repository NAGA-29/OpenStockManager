<?xml version="1.0"?>

<ruleset name="PSR2">
    <description>PSR-12 coding standard</description>
    <!-- 拡張子が php のものにだけ適用 -->
    <arg name="extensions" value="php" />

    <!-- 適用コーディング規約の指定 -->
    <rule ref="PSR2">
        <!-- 除外したい項目を列挙 -->
        <exclude name="Generic.Files.LineLength.TooLong" />
    </rule>
    <!-- メソッド名のキャメルケース -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <!-- ルールを除外 -->
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/Models/*</exclude-pattern>
    </rule>

    <!-- 特定のファイルで複数クラス定義エラーを無視する -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>*/app/Exceptions/CleanupCSVException.php</exclude-pattern>
    </rule>

    <!-- オプション p:進捗表示  s:エラー表示時にルールを表示 -->
    <arg value="ps" />
    <!-- 出力に色を適用 -->
    <arg name="colors" />

    <!-- 対象のファイル、ディレクトリ -->
    <file>app</file>
    <!-- 除外ディレクトリ -->
    <exclude-pattern>/bootstrap/*</exclude-pattern>
    <exclude-pattern>/database/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/public/*</exclude-pattern>
    <exclude-pattern>/resources/*</exclude-pattern>
    <exclude-pattern>/storage/*</exclude-pattern>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/server.php</exclude-pattern>

    <!-- 変数名をキャメルケースに（Laravel固有ルール） -->
    <!-- <rule ref="Squiz.NamingConventions.ValidVariableName.NotCamelCaps"/> -->
</ruleset>