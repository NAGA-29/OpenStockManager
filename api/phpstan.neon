includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app
        - tests

    # The level 9 is the highest level
    level: 5

    ignoreErrors:

    excludePaths:
        - ./app/Exceptions/*.php
        - ./app/Policies/*.php
        - ./app/Providers/*.php
        - ./app/Http/Middleware/*.php
        - ./tests/Feature/*/*.php 
        - ./tests/Unit/*.php  

