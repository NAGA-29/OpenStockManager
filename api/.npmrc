# =============================================================================
# pnpm セキュリティ設定
# =============================================================================

# --- パッケージ整合性 ---

# ストア内のパッケージのチェックサムを検証する（デフォルト: true）
verify-store-integrity=true

# HTTPS 通信を強制する
strict-ssl=true

# --- lockfile ---

# lockfile を優先使用し、不要な更新を防ぐ（開発環境向け）
prefer-frozen-lockfile=true

# lockfile が存在しない場合はエラー（誤ったディレクトリでの実行を防止）
lockfile=true

# --- レジストリ ---

# 使用するレジストリを明示（タイポスクワッティング対策）
registry=https://registry.npmjs.org/

# --- スクリプト実行 ---

# パッケージのライフサイクルスクリプト実行を許可
# セキュリティを最大化したい場合は ignore-scripts=true に変更（一部パッケージが動作しなくなる可能性あり）
ignore-scripts=false

# --- ピア依存関係 ---

# ピア依存関係の自動インストール
auto-install-peers=true
